# Sanity CMS — copy to .env and fill in after creating a Sanity project
# Create project: https://www.sanity.io/manage or run `npm run studio:init`

SANITY_PROJECT_ID=5c0bo9xi
SANITY_DATASET=production
SANITY_API_VERSION=2024-08-01

# Organization ID (Sanity dashboard / billing — not needed in app code)
# SANITY_ORGANIZATION_ID=oeqj3n4qi

# Optional: read token for preview/draft content (keep secret, server/build only)
# SANITY_READ_TOKEN=

# Site URL used by build scripts (defaults to https://www.eicng.com)
# SITE_URL=https://www.eicng.com
